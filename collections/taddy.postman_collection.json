            ],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{ getItunesInfo(uuid:\"PODCAST_UUID\"){ uuid itunesId baseArtworkUrl categories contentAdvisory } }",
