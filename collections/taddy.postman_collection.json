            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{ getEpisodeTranscript(uuid:\"EPISODE_UUID\"){ id text speaker startTimecode endTimecode } }",
                "variables": ""
              }
            },
            "description": "Get an episode transcript with per-line text, speaker names, and timecodes."
          }
        },
        {
          "name": "getEpisodeChapters",
          "request": {
            "method": "POST",
            "header": [
